/* Standalone Pulse Bootstrap ELF */
OUTPUT_FORMAT(elf64-x86-64)
OUTPUT_ARCH(i386:x86-64)
ENTRY(persona_entry)
PULSE_BASE = 0x400000;
PULSE_PAGE_SIZE = 4096;
PHDRS
{
    text PT_LOAD FLAGS(5);
    rodata PT_LOAD FLAGS(4);
    data PT_LOAD FLAGS(6);
    weaver PT_LOAD FLAGS(4);
    ahci PT_LOAD FLAGS(4);
    afs PT_LOAD FLAGS(4);
}
SECTIONS
{
    .text PULSE_BASE :
    {
        KEEP(*(.text.persona.entry))
        *(.text .text.*)
    } :text
    .rodata ALIGN(PULSE_PAGE_SIZE) :
    {
        *(.rodata .rodata.* .srodata .srodata.*)
    } :rodata
    .data ALIGN(PULSE_PAGE_SIZE) :
    {
        *(.data .data.* .sdata .sdata.* .got .got.*)
    } :data
    .bss ALIGN(PULSE_PAGE_SIZE) (NOLOAD) :
    {
        *(.bss .bss.* .sbss .sbss.*) *(COMMON)
    } :data
    .bootstrap.weaver 0x60000000 :
    {
        KEEP(*(.bootstrap.weaver))
    } :weaver
    .bootstrap.ahci 0x61000000 :
    {
        KEEP(*(.bootstrap.ahci))
    } :ahci
    .bootstrap.afs 0x62000000 :
    {
        KEEP(*(.bootstrap.afs))
    } :afs
    /DISCARD/ : { *(.comment .note .note.* .eh_frame .eh_frame.* .eh_frame_hdr) }
}
